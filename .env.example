# Copy to .env and fill in. NEVER commit .env
# Postgres (Neon/Supabase/…) or MongoDB (Atlas) — leave empty for inline long session IDs
DATABASE_URL=

# Session ID prefix shown to users
SESSION_PREFIX=JUNE-X~

# WhatsApp group invite CODE (the part after chat.whatsapp.com/) — auto-joined on pair. Empty = disabled
GC_JID=FiJ0HpoqKOS0llgeS1uydN

# Links shown in the session-delivery message buttons
BOT_REPO=https://github.com/eminentboy11/velvet-sparrow-sessions
WA_CHANNEL=https://whatsapp.com/channel/0029VbBzXBN2kNFoxm7LiG3Q

# Footer line on delivered messages
MSG_FOOTER=> *JUNE X SESSIONS*

SESSION_ID_LENGTH=8
PORT=50900
